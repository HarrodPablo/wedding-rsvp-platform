# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and replace placeholder values with your actual credentials.
# NOTE: Never commit your actual .env file with real secrets to version control.
# ==============================================================================

# 1. Database (Neon Serverless PostgreSQL)
# Make sure to use the connection string with the "-pooler" suffix and pgbouncer=true
# Example: postgresql://username:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-project-pooler.region.aws.neon.tech/dbname?sslmode=require"

# 2. Gmail SMTP Service (Nodemailer)
# Requires a Gmail account with 2-Step Verification and an App Password
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

# 3. Google Sheets API Integration (Service Account)
# Created in Google Cloud Console with Google Sheets API enabled.
# Make sure to share your Google Sheet (Editor permissions) with the service account email.
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID="your_google_sheet_document_id_here"
